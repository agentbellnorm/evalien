  "panels": [
    {
      "type": "stat",
      "title": "Spent today",
      "description": "Model spend so far today (UTC) against the daily budget. At the budget, model calls pause until midnight.",
      "datasource": {
        "type": "prometheus",
        "uid": "ef5czm09vokcge"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ef5czm09vokcge"
          },
          "expr": "max(evalien_budget_spent_today_usd)",
          "legendFormat": "spent",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ef5czm09vokcge"
          },
          "expr": "max(evalien_budget_daily_usd)",
          "legendFormat": "budget",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "id": 1
    },
