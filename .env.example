MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=

# To use OpenAI instead:
# MODEL=openai/gpt-5.4
# OPENAI_API_KEY=

# To use Gemini instead:
# MODEL=google/gemini-2.5-flash
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional generation settings:
# MODEL_MAX_OUTPUT_TOKENS=4096
# MODEL_BASE_URL=https://your-provider-endpoint/v1

# Spend limit per process, in USD (default 1). The runtime stops when it's reached.
# MODEL_BUDGET_USD=1
# Required for models without built-in rates: USD per million tokens.
# MODEL_PRICING=input,output,cacheRead,cacheWrite
